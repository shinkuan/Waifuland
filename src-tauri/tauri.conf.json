{
  "$schema": "https://raw.githubusercontent.com/nicep/tauri-schema/refs/heads/main/tauri-conf-v2.schema.json",
  "productName": "Waifuland",
  "version": "0.1.0",
  "identifier": "com.waifuland.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Waifuland",
        "width": 600,
        "height": 800,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false
      }
    ]
  },
  "plugins": {
    "shell": {
      "open": false
    }
  }
}
