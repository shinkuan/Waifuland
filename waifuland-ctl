#!/usr/bin/env bash
#
# waifuland-ctl - CLI client for controlling Waifuland via its IPC socket.
#
# Usage:
#   waifuland-ctl [-c] <command> [--key value | --key=value | --flag ...]
#   waifuland-ctl [-c] --json '<request JSON>'
#
# Values are sent as JSON numbers, true/false/null, raw JSON when they start
# with '{' or '[', and as strings otherwise. A --flag without a value is true.
# -c prints the response compactly on one line.
#
# Examples:
#   waifuland-ctl list_commands
#   waifuland-ctl describe_model
#   waifuland-ctl set_expression --id happy --duration 5
#   waifuland-ctl toggle_expression --id glasses --active true
#   waifuland-ctl do_motion --group TapBody --index 0
#   waifuland-ctl set_pose --head_x 0.5 --mouth_open 1 --duration 3
#   waifuland-ctl set_parameters --params '{"ParamCheek":1}' --fade 0.5
#   waifuland-ctl get_parameters --filter mouth
#   waifuland-ctl set_look --x 0.5 --y 0.3 --duration 2
#   waifuland-ctl set_look --reset
#   waifuland-ctl --json '{"command":"batch","commands":[{"command":"set_expression","id":"happy"},{"command":"do_motion","group":"TapBody"}]}'
#
# The socket path is $XDG_RUNTIME_DIR/waifuland.sock (fallback: /tmp/waifuland.sock)

set -euo pipefail

SOCK="${XDG_RUNTIME_DIR:-/tmp}/waifuland.sock"
COMPACT=0

usage() {
    cat <<'EOF'
Usage: waifuland-ctl [-c] <command> [--key value ...]
       waifuland-ctl [-c] --json '<request JSON>'

Run `waifuland-ctl list_commands` for all commands and their arguments,
and `waifuland-ctl describe_model` for what the current model supports.
EOF
}

json_string() {
    local s="$1"
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\t'/\\t}
    s=${s//$'\r'/\\r}
    printf '"%s"' "$s"
}

json_value() {
    local v="$1"
    if [[ "$v" =~ ^-?([0-9]+\.?[0-9]*|\.[0-9]+)([eE][-+]?[0-9]+)?$ ]] || \
       [[ "$v" == "true" || "$v" == "false" || "$v" == "null" ]] || \
       [[ "$v" == \{* || "$v" == \[* ]]; then
        printf '%s' "$v"
    else
        json_string "$v"
    fi
}

if [ "${1:-}" = "-c" ]; then
    COMPACT=1
    shift
fi

if [ $# -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    usage
    exit 1
fi

if [ "$1" = "--json" ]; then
    if [ $# -lt 2 ]; then
        echo "Error: --json needs a request" >&2
        exit 1
    fi
    JSON="$2"
else
    COMMAND="$1"
    shift
    JSON="{\"command\":$(json_string "$COMMAND")"
    while [ $# -gt 0 ]; do
        arg="$1"
        shift
        if [[ "$arg" != --* ]]; then
            echo "Error: unexpected argument '$arg' (use --key value)" >&2
            exit 1
        fi
        key="${arg#--}"
        if [[ "$key" == *=* ]]; then
            value="${key#*=}"
            key="${key%%=*}"
        elif [ $# -eq 0 ] || [[ "$1" == --* ]]; then
            value="true"
        else
            value="$1"
            shift
        fi
        JSON="$JSON,$(json_string "$key"):$(json_value "$value")"
    done
    JSON="$JSON}"
fi

if [ ! -S "$SOCK" ]; then
    echo "Error: Waifuland is not running (socket not found: $SOCK)" >&2
    exit 1
fi

send() {
    if command -v socat &>/dev/null; then
        printf '%s\n' "$1" | socat -t 2 - UNIX-CONNECT:"$SOCK" 2>/dev/null
    elif command -v python3 &>/dev/null; then
        python3 -I -c '
import socket, sys
s = socket.socket(socket.AF_UNIX)
s.settimeout(5)
s.connect(sys.argv[1])
s.sendall(sys.argv[2].encode() + b"\n")
buf = b""
while not buf.endswith(b"\n"):
    chunk = s.recv(65536)
    if not chunk:
        break
    buf += chunk
sys.stdout.write(buf.decode())
' "$SOCK" "$1"
    else
        echo "Error: socat or python3 is required." >&2
        return 1
    fi
}

RESPONSE=$(send "$JSON") || {
    echo "Error: Failed to communicate with Waifuland (socket: $SOCK)." >&2
    exit 1
}

if [ "$COMPACT" = "0" ] && command -v python3 &>/dev/null; then
    printf '%s\n' "$RESPONSE" | python3 -I -m json.tool --no-ensure-ascii 2>/dev/null || printf '%s\n' "$RESPONSE"
else
    printf '%s\n' "$RESPONSE"
fi

# Exit status 2 when Waifuland reports an error
case "$RESPONSE" in
    '{"ok":false'*) exit 2 ;;
esac
